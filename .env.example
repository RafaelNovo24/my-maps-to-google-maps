# Template for local secrets. Copy to .env and fill in your key:
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
# The real .env is gitignored, so your key is never committed.
#
# Get a key: Google Cloud Console -> enable "Routes API" + billing ->
#   Credentials -> create API key -> restrict the key to the Routes API.
GOOGLE_MAPS_API_KEY=
